@model Shopping.MVC.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Id</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>@Model.Price</td>
    </tr>

</table>

<a asp-action="Items" class="btn btn-secondary">
    Back
</a>